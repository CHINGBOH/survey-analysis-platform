# DeepSeek LLM (必填)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Langfuse 可观测性 (可选) ─────────────────────────────────
# 启用后,所有 LLM 调用 + 工具调用会上报到 Langfuse,提供调用链 UI/聚合统计。
# 未填写时静默降级,不影响主流程。
#
# 注册免费账号: https://cloud.langfuse.com
# 或自部署:    docker run -p 3000:3000 langfuse/langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
